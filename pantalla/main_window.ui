  <property name="styleSheet">
   <string notr="true">/* --------------------------------------------------------- */
/* FONDO GENERAL VENTANA PRINCIPAL                */
/* --------------------------------------------------------- */
QMainWindow {
    background-color: #F5F7FA;
}

/* --------------------------------------------------------- */
/* ESTILO GENERAL DE LOS GROUPBOX                      */
/* Cambio de:
   - color de fondo de los bloques
   - borde
   - esquinas redondeadas
   - color del título
*/
/* --------------------------------------------------------- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D9E1EA;
    border-radius: 8px;
    margin-top: 10px;
    font-weight: 600;
    color: #1F4E79;
}

/* --------------------------------------------------------- */
/* TÍTULO DE LOS GROUPBOX                                    */
/* Posición y espacio del título */
/* --------------------------------------------------------- */
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px 0 4px;
}

/* --------------------------------------------------------- */
/* ESTILO DE CAJAS DE ENTRADA                                */
/* Afecta a:
   - QDoubleSpinBox
   - QSpinBox
   - QComboBox
   - QLineEdit
   - QPlainTextEdit

   Cambio de:
   - fondo blanco
   - borde gris suave
   - esquinas redondeadas
   - color del texto
*/
/* --------------------------------------------------------- */
QDoubleSpinBox, QSpinBox, QComboBox, QLineEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #C8D2DC;
    border-radius: 6px;
    padding: 4px 6px;
    color: #2F3A45;
}

/* --------------------------------------------------------- */
/* EFECTO CUANDO HACES CLIC EN UNA CAJA                      */
/* Cambia el borde al seleccionar el widget                  */
/* --------------------------------------------------------- */
QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus, QLineEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #5AA9E6;
}

/* --------------------------------------------------------- */
/* BLOQUES PRINCIPALES                                       */
/* Parameters / Monitoring / Identification                  */
/* --------------------------------------------------------- */
QGroupBox#parametersGroupBox,
QGroupBox#monitoringGroupBox,
QGroupBox#identificationGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #C9D5E2;
    border-radius: 10px;
    margin-top: 12px;
    font-weight: 700;
    color: #1F4E79;
}

/* --------------------------------------------------------- */
/* TÍTULOS DE LOS BLOQUES PRINCIPALES                        */
/* --------------------------------------------------------- */
QGroupBox#parametersGroupBox::title,
QGroupBox#monitoringGroupBox::title,
QGroupBox#identificationGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px 0 5px;
}


/* --------------------------------------------------------- */
/* ESTILO BASE DE TODOS LOS BOTONES                          */
/* Más compactos y técnicos                                  */
/* --------------------------------------------------------- */
QPushButton {
    border-radius: 6px;
    padding: 4px 10px;
    font-weight: 600;
    min-height: 22px;
    background-color: #FFFFFF;
    border: 1px solid #C8D2DC;
    color: #44515E;
}

/* --------------------------------------------------------- */
/* BOTONES AZULES - acciones principales                     */
/* Connect / Start / Run                                     */
/* --------------------------------------------------------- */
QPushButton#connectButton,
QPushButton#startButton,
QPushButton#runButton,
QPushButton#startIdentificationButton {
    background-color: #DCEEFF;
    border: 1px solid #5AA9E6;
    color: #1F5F99;
}

QPushButton#connectButton:hover,
QPushButton#startButton:hover,
QPushButton#runButton:hover,
QPushButton#startIdentificationButton:hover {
    background-color: #CFE7FF;
}

QPushButton#connectButton:pressed,
QPushButton#startButton:pressed,
QPushButton#runButton:pressed,
QPushButton#startIdentificationButton:pressed {
    background-color: #BDDFFF;
}

/* --------------------------------------------------------- */
/* BOTONES ROJOS - acciones de parar o desconectar           */
/* Stop / Disconnect                                         */
/* --------------------------------------------------------- */
QPushButton#disconnectButton,
QPushButton#stopButton,
QPushButton#stopModeButton,
QPushButton#stopIdentificationButton {
    background-color: #FDE2E2;
    border: 1px solid #E57373;
    color: #B23A3A;
}

QPushButton#disconnectButton:hover,
QPushButton#stopButton:hover,
QPushButton#stopModeButton:hover,
QPushButton#stopIdentificationButton:hover {
    background-color: #FAD4D4;
}

QPushButton#disconnectButton:pressed,
QPushButton#stopButton:pressed,
QPushButton#stopModeButton:pressed,
QPushButton#stopIdentificationButton:pressed {
    background-color: #F6C1C1;
}

/* --------------------------------------------------------- */
/* BOTONES NEUTROS - acciones secundarias                    */
/* Defaults / Export / Apply Parameters                      */
/* --------------------------------------------------------- */
QPushButton#defaultsButton,
QPushButton#exportButton,
QPushButton#applyParametersButton {
    background-color: #FFFFFF;
    border: 1px solid #BFCAD6;
    color: #44515E;
}

QPushButton#defaultsButton:hover,
QPushButton#exportButton:hover,
QPushButton#applyParametersButton:hover {
    background-color: #F6F9FC;
}

QPushButton#defaultsButton:pressed,
QPushButton#exportButton:pressed,
QPushButton#applyParametersButton:pressed {
    background-color: #EAF0F5;
}


/* --------------------------------------------------------- */
/* BARRA DE PROGRESO         */
/* --------------------------------------------------------- */

/* --------------------------------------------------------- */
/* PARTE EXTERIOR DE LA BARRA                                */
/* Cambia:
   - color de fondo de la barra vacía
   - borde exterior
   - esquinas redondeadas
   - altura de la barra
   - color del texto del porcentaje
*/
/* --------------------------------------------------------- */
QProgressBar {
    background-color: #EEF3F7;
    border: 1px solid #D6E0EA;
    border-radius: 7px;
    text-align: center;
    color: #3A4A5A;
    min-height: 18px;
    max-height: 18px;
}

/* --------------------------------------------------------- */
/* PARTE RELLENA DE LA BARRA                                 */
/* Cambia:
   - color azul pastel del progreso
   - redondeo interior
   - margen para que no toque el borde exterior
*/
/* --------------------------------------------------------- */
QProgressBar::chunk {
    background-color: #A9D6FF;
    border-radius: 6px;
    margin: 1px;
}


/* --------------------------------------------------------- */
/* LOG - ESTILO                                 */
/* Este bloque cambia el aspecto del QPlainTextEdit del log  */
/* --------------------------------------------------------- */

/* --------------------------------------------------------- */
/* CAJA DEL LOG                                              */
/* Cambia:
   - fondo del log
   - borde
   - esquinas redondeadas
   - color del texto
   - tipo de letra más técnico
*/
/* --------------------------------------------------------- */
QPlainTextEdit {
    background-color: #F3F7FA;
    border: 1px solid #D3DDE7;
    border-radius: 6px;
    color: #334455;
    padding: 6px;
    font-family: &quot;Consolas&quot;;
    font-size: 10pt;
}

/* --------------------------------------------------------- */
/* LOG                         */
/* Cambia el borde al hacer clic dentro del log              */
/* --------------------------------------------------------- */
QPlainTextEdit:focus {
    border: 1px solid #8CBFE8;
}</string>
